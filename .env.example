# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority


# CORS Configuration
# Add your frontend URL here
FRONTEND_URL=http://localhost:5174

# # Twilio Configuration for SMS/OTP
# # Get your credentials from: https://www.twilio.com/console
# # IMPORTANT: Keep these credentials secure and never commit to git
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# JWT Secrets
# Generate secure random secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_this_in_production

# Email Configuration (for OTP and notifications)
# Example for Gmail: smtp.gmail.com, port 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=Jobseek <noreply@jobseek.com>

# Cloudinary Configuration (for file uploads)
# Get your credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 / Cloudflare R2 Configuration (for file uploads)
# For AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-bucket-name
S3_PUBLIC_URL=https://your-bucket-name.s3.amazonaws.com

# For Cloudflare R2 (optional, overrides S3 settings)
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Redis Configuration (for BullMQ queue service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_optional

# Logging Configuration
LOG_LEVEL=info

# External Job API Keys
# Adzuna API: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Findwork API: https://findwork.dev/api/
FINDWORK_API_KEY=your_findwork_api_key

# Remotive API: https://remotive.com/api (public, no key needed)
# Arbeitnow API: https://www.arbeitnow.com/api/job-board-api (public, no key needed)